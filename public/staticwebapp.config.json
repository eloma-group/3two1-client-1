{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*",
      "/videos/*",
      "/assets/*",
      "*.{png,jpg,jpeg,gif,svg,webp,mp4,webm,ico,css,js,xml,txt,pdf}"
    ]
  },
  "mimeTypes": {
    ".webm": "video/webm",
    ".mp4": "video/mp4"
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "route": "/videos/*",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    }
  ]
}
